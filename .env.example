# ==============================================================================
# PHYSORA ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and replace with your Supabase project keys
# Available in your Supabase Dashboard: Settings -> API
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon Public Key (safe to use in client-side code)
# NEVER include the service_role key here!
VITE_SUPABASE_ANON_KEY=your-anon-key-here
