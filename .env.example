# ==============================================================================
# PHYSORA ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your Supabase & Stripe keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (Frontend)
# Find in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 2. STRIPE CLIENT CONFIGURATION (Frontend)
# Find in: Stripe Dashboard -> Developers -> API keys (Publishable key)
# e.g., pk_test_51... or pk_live_51...
# ------------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# ------------------------------------------------------------------------------
# 3. DIRECT UPI CONFIGURATION (India Payments - Option B)
# Put your Google Pay / PhonePe / BHIM UPI ID & Payee Name here:
# ------------------------------------------------------------------------------
VITE_UPI_ID=physora.edu@okaxis
VITE_UPI_PAYEE_NAME="Physora STEM Education"

# ------------------------------------------------------------------------------
# 4. SUPABASE EDGE FUNCTIONS & WEBHOOK SECRETS (Server-side)
# Set these via Supabase CLI:
# supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_...
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

